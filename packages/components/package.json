{
  "name": "@cascade-ds/components",
  "version": "0.5.0",
  "description": "React components for Cascade DS: token-driven, themeable with pure CSS, styled with Linaria.",
  "keywords": [
    "design-system",
    "react",
    "components",
    "design-tokens",
    "dark-mode",
    "linaria"
  ],
  "license": "MIT",
  "author": "Sergio Segaty",
  "homepage": "https://github.com/cascade-ds/cascade-design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascade-ds/cascade-design-system.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/cascade-ds/cascade-design-system/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "API.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "motion": ">=12.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/rollup-plugin-css-only": "^3.1.3",
    "@wyw-in-js/rollup": "^2.5.1",
    "@wyw-in-js/vite": "^2.5.1",
    "jsdom": "^30.0.1",
    "motion": "^13.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.88.0",
    "rollup": "^4.63.2",
    "rollup-plugin-css-only": "^4.5.5",
    "storybook": "^10.6.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cascade-ds/styles": "workspace:*",
    "@linaria/core": "^8.2.0",
    "class-variance-authority": "^0.7.1"
  }
}
