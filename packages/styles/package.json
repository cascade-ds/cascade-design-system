{
  "name": "@cascade-ds/styles",
  "version": "0.1.0",
  "description": "Design tokens for Cascade DS as CSS custom properties, a typed theme object and motion values.",
  "keywords": [
    "design-system",
    "design-tokens",
    "css-variables",
    "theme",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "Sergio Segaty",
  "homepage": "https://github.com/SergioSegaty/cascade-design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioSegaty/cascade-design-system.git",
    "directory": "packages/styles"
  },
  "bugs": {
    "url": "https://github.com/SergioSegaty/cascade-design-system/issues"
  },
  "private": false,
  "type": "module",
  "main": "./theme.js",
  "types": "./theme.d.ts",
  "files": [
    "index.css",
    "theme.js",
    "theme.d.ts",
    "theme-names.js",
    "theme-names.d.ts",
    "motion.js",
    "motion.d.ts",
    "media.js",
    "media.d.ts",
    "media.css"
  ],
  "exports": {
    ".": {
      "types": "./theme.d.ts",
      "import": "./theme.js"
    },
    "./theme-names": {
      "types": "./theme-names.d.ts",
      "import": "./theme-names.js"
    },
    "./motion": {
      "types": "./motion.d.ts",
      "import": "./motion.js"
    },
    "./media": {
      "types": "./media.d.ts",
      "import": "./media.js"
    },
    "./index.css": "./index.css",
    "./media.css": "./media.css"
  }
}
