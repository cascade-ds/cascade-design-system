# Build context is the repo root. Host installs and builds are platform-specific
# or regenerated inside the image, so none of them go in.
**/node_modules
**/dist
**/storybook-static
coverage
.git
.claude

# Generated token output (regenerated by `pnpm build:style` in the image).
packages/styles/*
!packages/styles/package.json
!packages/styles/README.md
!packages/styles/LICENSE

# Mounted at run time, so changing them never invalidates the image.
packages/storybook/visual/__screenshots__
packages/storybook/visual/report
packages/storybook/visual/test-results
