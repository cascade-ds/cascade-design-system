{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["react", "react-dom", "vite/client", "node"],
    "paths": {
      "@cds/components": ["../components/src/index.ts"],
      "@cds/components/motion": ["../components/src/motion.ts"],
      "@cds/styles": ["../styles/theme.d.ts"],
      "@cds/styles/*": ["../styles/*"]
    },
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "playwright.config.ts",
    "visual/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
