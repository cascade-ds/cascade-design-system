{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["react", "react-dom", "vite/client", "node"],
    "paths": {
      "#/*": ["../components/src/*"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "playwright.config.ts",
    "visual/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
