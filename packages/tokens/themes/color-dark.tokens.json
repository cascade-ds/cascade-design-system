        },
        "accent-hover": {
          "$value": "{primitive.color.yellow.200}"
        },
        "accent-active": {
          "$value": "{primitive.color.yellow.400}"
        },
        "accent-strong": {
          "$value": "{primitive.color.yellow.300}",
