{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "semantic": {
    "color": {
      "$description": "Mode: dark = Sunrise. Neutral gray surfaces step UP in lightness with elevation (canvas gray.950 -> default 850 -> raised 800). Primary is the first-light coral with DARK text (text.on-primary); secondary is the dawn-sky blue; tertiary rose cloud doubles as the link color; accent is the sun rim (decorative). Small indicators and text use the 300-400 tints so they stay >= 3:1 / 4.5:1 on dark surfaces.",
      "background": {
        "$type": "color",
        "canvas": {
          "$value": "{primitive.color.gray.950}",
          "$description": "App page background behind cards."
        },
        "default": {
          "$value": "{primitive.color.gray.850}",
          "$description": "Default surface: cards, panels, sidebar, topbar, inputs."
        },
        "raised": {
          "$value": "{primitive.color.gray.800}",
          "$description": "Popovers, dropdowns, modals - lighter than the surface to read as elevated."
        },
        "subtle": {
          "$value": "{primitive.color.gray.800}",
          "$description": "Table headers, hover rows, inset areas."
        },
        "muted": {
          "$value": "{primitive.color.gray.750}",
          "$description": "Skeletons, pressed neutral controls."
        },
        "inverse": {
          "$value": "{primitive.color.night.100}",
          "$description": "Tooltips, toasts (light on dark)."
        },
        "disabled": {
          "$value": "{primitive.color.gray.800}"
        },
        "transparent": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0
          }
        },
        "overlay": {
          "$value": "{primitive.color.alpha.black.70}",
          "$description": "Modal/drawer scrim - stronger than light mode to separate from a dark page."
        },
        "hover": {
          "$value": "{primitive.color.alpha.white.4}",
          "$description": "Neutral hover tint (lightens) over any surface."
        },
        "pressed": {
          "$value": "{primitive.color.alpha.white.8}",
          "$description": "Neutral pressed tint over any surface."
        },
        "brand": {
          "$value": "{primitive.color.pink.950}",
          "$description": "Plum-tinted surface (hero/empty states)."
        },
        "selected": {
          "$value": "{primitive.color.pink.950}",
          "$description": "Selected rows, active nav item."
        }
      },
      "text": {
        "$type": "color",
        "primary": {
          "$value": "{primitive.color.night.50}",
          "$description": "Headings, body, KPI values."
        },
        "secondary": {
          "$value": "{primitive.color.night.300}",
          "$description": "Labels, metadata. AA on every background incl. muted."
        },
        "tertiary": {
          "$value": "{primitive.color.night.400}",
          "$description": "Placeholders, captions. 6.9:1 on canvas, 6.3:1 on default, 5.6:1 on raised/subtle, 5.0:1 on muted."
        },
        "disabled": {
          "$value": "{primitive.color.night.500}",
          "$description": "Disabled text: ~3:1 on the dark surfaces, faded on purpose (exempt from WCAG contrast)."
        },
        "inverse": {
          "$value": "{primitive.color.night.900}"
        },
        "link": {
          "$value": "{primitive.color.pink.400}",
          "$description": "Rose cloud (tertiary)."
        },
        "link-hover": {
          "$value": "{primitive.color.pink.300}"
        },
        "brand": {
          "$value": "{primitive.color.orange.300}",
          "$description": "Coral text on dark surfaces (AA)."
        },
        "on-primary": {
          "$value": "{primitive.color.orange.950}",
          "$description": "Text/icons on brand.primary fills (first-light coral, dark #1A0F0C)."
        },
        "on-secondary": {
          "$value": "{primitive.color.night.950}",
          "$description": "Text/icons on brand.secondary fills (dawn-sky blue)."
        },
        "on-danger": {
          "$value": "{primitive.color.night.950}",
          "$description": "Dark text on the light red danger fill (white fails on red.400)."
        },
        "on-tertiary": {
          "$value": "{primitive.color.night.950}",
          "$description": "Text/icons on brand.tertiary fills."
        },
        "on-accent": {
          "$value": "{primitive.color.night.950}",
          "$description": "Text/icons on brand.accent fills."
        },
        "on-success": {
          "$value": "{primitive.color.night.950}",
          "$description": "Text/icons on feedback.success fills."
        },
        "on-info": {
          "$value": "{primitive.color.night.950}",
          "$description": "Text/icons on feedback.info fills."
        },
        "on-brand": {
          "$value": "{semantic.color.text.on-primary}",
          "$description": "DEPRECATED alias of text.on-primary (kept for back-compat)."
        }
      },
      "icon": {
        "$type": "color",
        "primary": {
          "$value": "{primitive.color.night.300}"
        },
        "secondary": {
          "$value": "{primitive.color.night.400}",
