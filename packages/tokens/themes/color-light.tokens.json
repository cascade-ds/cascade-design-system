          "$description": "Decorative only (inner table rules)."
        },
        "default": {
          "$value": "{primitive.color.sand.200}",
          "$description": "Decorative: card, sidebar, topbar, dividers."
        },
        "card": {
          "$value": "{primitive.color.sand.350}",
          "$description": "Default card outline: stronger than border.default so cards stand out from the page."
        },
        "strong": {
          "$value": "{primitive.color.sand.450}"
        },
        "input": {
          "$value": "{primitive.color.sand.500}",
