{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "semantic": {
    "color": {
      "$description": "Mode: light. Sunset - warm cream surfaces and espresso text. Brand primary = ember (deep vermilion) with WHITE text, brand secondary = afterglow (crimson rose) with WHITE text, tertiary/links = dusk purple, accent = golden hour (decorative only, never text).",
      "background": {
        "$type": "color",
        "canvas": {
          "$value": "{primitive.color.sand.50}",
          "$description": "App page background behind cards."
        },
        "default": {
          "$value": "{primitive.color.white}",
          "$description": "Default surface: cards, panels, sidebar, topbar, inputs."
        },
        "raised": {
          "$value": "{primitive.color.white}",
          "$description": "Popovers, dropdowns, modals (pair with elevation)."
        },
        "subtle": {
          "$value": "{primitive.color.sand.100}",
          "$description": "Table headers, hover rows, inset areas."
        },
        "muted": {
          "$value": "{primitive.color.sand.200}",
          "$description": "Skeletons, pressed neutral controls."
        },
        "inverse": {
          "$value": "{primitive.color.sand.900}",
          "$description": "Tooltips, toasts."
        },
        "disabled": {
          "$value": "{primitive.color.sand.100}"
        },
        "transparent": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0
          }
        },
        "overlay": {
          "$value": "{primitive.color.alpha.black.50}",
          "$description": "Modal/drawer scrim."
        },
        "hover": {
          "$value": "{primitive.color.alpha.black.4}",
          "$description": "Neutral hover tint over any surface."
        },
        "pressed": {
          "$value": "{primitive.color.alpha.black.8}",
          "$description": "Neutral pressed tint over any surface."
        },
        "brand": {
          "$value": "{primitive.color.orange.50}",
          "$description": "Ember-tinted surface (hero/empty states)."
        },
        "selected": {
          "$value": "{primitive.color.orange.50}",
          "$description": "Selected rows, active nav item."
        }
      },
      "text": {
        "$type": "color",
        "primary": {
          "$value": "{primitive.color.sand.900}",
          "$description": "Headings, body, KPI values."
        },
        "secondary": {
          "$value": "{primitive.color.sand.600}",
          "$description": "Labels, metadata. AA on every surface."
        },
        "tertiary": {
          "$value": "{primitive.color.sand.550}",
          "$description": "Placeholders, captions. AA (4.9:1+) on every surface, incl. muted."
        },
        "disabled": {
          "$value": "{primitive.color.sand.400}",
          "$description": "Disabled text (exempt from WCAG contrast)."
        },
        "inverse": {
          "$value": "{primitive.color.sand.50}"
        },
        "link": {
          "$value": "{primitive.color.purple.600}",
          "$description": "Dusk purple (tertiary). 6:1 on white."
        },
        "link-hover": {
          "$value": "{primitive.color.purple.700}"
        },
        "brand": {
          "$value": "{primitive.color.orange.700}",
          "$description": "Ember text on white/canvas (AA)."
        },
        "on-primary": {
          "$value": "{primitive.color.white}",
          "$description": "Text/icons on brand.primary fills (ember)."
        },
        "on-secondary": {
          "$value": "{primitive.color.white}",
          "$description": "Text/icons on brand.secondary fills (afterglow)."
        },
        "on-danger": {
          "$value": "{primitive.color.white}",
          "$description": "Text/icons on feedback.danger fills."
        },
        "on-tertiary": {
          "$value": "{primitive.color.white}",
          "$description": "Text/icons on brand.tertiary fills."
        },
        "on-accent": {
          "$value": "{primitive.color.sand.950}",
          "$description": "Text/icons on brand.accent fills."
        },
        "on-success": {
          "$value": "{primitive.color.white}",
          "$description": "Text/icons on feedback.success fills."
        },
        "on-info": {
          "$value": "{primitive.color.white}",
          "$description": "Text/icons on feedback.info fills."
        },
        "on-brand": {
          "$value": "{semantic.color.text.on-primary}",
          "$description": "DEPRECATED alias of text.on-primary (kept for back-compat). Was white; now dark because the brand is light."
        }
      },
      "icon": {
        "$type": "color",
        "primary": {
          "$value": "{primitive.color.sand.700}"
        },
        "secondary": {
          "$value": "{primitive.color.sand.500}",
