        "tertiary-hover": {
          "$value": "{primitive.color.purple.700}"
        },
        "tertiary-active": {
          "$value": "{primitive.color.purple.800}"
        },
        "accent-hover": {
          "$value": "{primitive.color.yellow.600}"
        },
        "accent-active": {
          "$value": "{primitive.color.yellow.700}"
        },
        "accent-strong": {
          "$value": "{primitive.color.yellow.700}",
          "$description": "Accent for small indicators (switch track, slider fill, spinner): >= 3:1 on the surface."
