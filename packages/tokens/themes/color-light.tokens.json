        "secondary-hover": {
          "$value": "{primitive.color.pink.800}"
        },
        "secondary-active": {
          "$value": "{primitive.color.pink.900}"
        },
        "secondary-strong": {
          "$value": "{primitive.color.pink.700}"
        },
        "secondary-subtle": {
          "$value": "{primitive.color.pink.50}"
        },
        "secondary-muted": {
          "$value": "{primitive.color.pink.100}"
        },
        "secondary-surface": {
          "$value": "{primitive.color.pink.100}",
